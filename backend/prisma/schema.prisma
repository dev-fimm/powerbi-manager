// ============================================================
// Prisma schema - Sistema de gerenciamento de iframes Power BI
// Banco: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DESENVOLVEDOR
  GESTOR
  VISUALIZADOR
}

// Alvo de um contador de tentativas de login. A protecao age nos dois
// eixos: a conta (impede forca bruta contra uma senha) e o IP (impede que um
// atacante varra muitas contas da mesma origem).
enum ThrottleScope {
  ACCOUNT
  IP
}

enum ContractStatus {
  ATIVO
  SUSPENSO
  ENCERRADO
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(VISUALIZADOR)
  isActive      Boolean  @default(true) @map("is_active")
  // Telas que a conta pode acessar no frontend (ex.: "dashboard", "contracts").
  // Substitui o menu padrao do perfil. ADMIN sempre acessa tudo (ignora esta lista).
  allowedScreens String[] @default([]) @map("allowed_screens")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Ao excluir um usuario, apenas as associacoes sao removidas (cascade em UserContract).
  // Os contratos NUNCA sao excluidos junto - regra de negocio 7.
  contracts UserContract[]

  // Logs de auditoria gerados por este usuario. Ao excluir o usuario, o vinculo
  // vira null (onDelete: SetNull) para preservar o historico de auditoria.
  auditLogs AuditLog[]

  // Concessoes de dashboards (iframes) por conta. Usado apenas para VISUALIZADOR:
  // o viewer desse perfil so exibe os iframes explicitamente concedidos aqui.
  iframeGrants UserIframe[]

  // Sessoes de uso medidas por heartbeat (tela de Monitoramento). Ao excluir
  // a conta as sessoes vao junto: sem o usuario elas nao medem nada.
  accessSessions AccessSession[]

  @@map("users")
}

model Contract {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  clientName  String         @map("client_name")
  description String?        @db.Text
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  status      ContractStatus @default(ATIVO)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Cascade delete: excluir o contrato remove seus iframes e suas associacoes.
  iframes Iframe[]
  users   UserContract[]

  // Tempo medido de permanencia na tela deste contrato.
  usage SessionContractUsage[]

  @@index([status])
  @@map("contracts")
}

model Iframe {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  powerBiUrl  String   @map("power_bi_url")
  description String?  @db.Text
  contractId  String   @map("contract_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Todo iframe pertence obrigatoriamente a um contrato (regra 3).
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Contas (VISUALIZADOR) que tem acesso a este dashboard.
  viewers UserIframe[]

  @@index([contractId])
  @@index([isActive])
  @@map("iframes")
}

// ============================================================
// Concessao de dashboard por conta (acesso individual a iframes).
// Usado para distribuir, por VISUALIZADOR, quais paineis ele pode
// ver no viewer. Sem concessao, o VISUALIZADOR nao ve nenhum painel.
// ============================================================
model UserIframe {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  iframeId  String   @map("iframe_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  iframe Iframe @relation(fields: [iframeId], references: [id], onDelete: Cascade)

  @@unique([userId, iframeId])
  @@index([userId])
  @@index([iframeId])
  @@map("user_iframes")
}

// ============================================================
// Sessao de uso - mede TEMPO de permanencia no sistema.
//
// Por que nao sai do audit_logs: la so existem eventos pontuais, e o fim de
// uma sessao dependia do LOGOUT, que so e gravado quando a pessoa clica em
// "Sair". Quem fecha a aba - a maioria - nunca gerava o evento.
//
// Aqui o modelo e invertido: a aba aberta manda um sinal periodico e o
// servidor so adianta last_seen_at. A duracao e last_seen_at - started_at.
// Se o navegador fecha, trava ou a maquina hiberna, o sinal para de chegar e
// a duracao congela sozinha - nao existe sessao "aberta para sempre".
// ============================================================
model AccessSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  startedAt  DateTime @default(now()) @map("started_at")
  // Ultimo sinal recebido. Avanca a cada heartbeat enquanto a aba esta aberta.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  // Contrato que a aba estava exibindo no sinal ANTERIOR. O intervalo entre
  // dois sinais pertence a onde a pessoa estava DURANTE o intervalo, nao a
  // onde ela chegou - por isso o contrato anterior, e nao o atual.
  lastContractId String? @map("last_contract_id") @db.Uuid

  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage SessionContractUsage[]

  @@index([userId])
  // A consulta quente e "sessao aberta desta conta" e "sessoes do periodo".
  @@index([userId, lastSeenAt])
  @@index([startedAt])
  @@map("access_sessions")
}

// ============================================================
// Tempo MEDIDO por contrato dentro de uma sessao.
//
// Cada sinal de heartbeat soma aqui o intervalo desde o sinal anterior, no
// contrato em que a aba estava. E medicao, nao estimativa: so entra tempo
// que ficou entre dois sinais efetivamente recebidos.
//
// A linha e por (sessao, contrato), entao o expurgo das sessoes leva o tempo
// junto (cascade) e o recorte por periodo sai pelo started_at da sessao.
// ============================================================
model SessionContractUsage {
  id         String @id @default(uuid()) @db.Uuid
  sessionId  String @map("session_id") @db.Uuid
  contractId String @map("contract_id") @db.Uuid
  seconds    Int    @default(0)

  session  AccessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contract Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([sessionId, contractId])
  @@index([contractId])
  @@map("session_contract_usage")
}

// ============================================================
// Contador de tentativas de login - protecao contra forca bruta.
//
// Uma linha por alvo (conta ou IP). O contador vive dentro de uma JANELA:
// passada a janela sem nova falha, ele recomeca do zero. Estourado o limite
// dentro da janela, blocked_until marca o fim do bloqueio.
//
// Mora no banco, e nao em memoria, por dois motivos: o contador sobrevive a
// um restart da API (senao bastaria derrubar o processo para zerar o
// bloqueio) e o incremento pode ser serializado de verdade, sem depender do
// processo ser unico.
// ============================================================
model LoginThrottle {
  id    String        @id @default(uuid()) @db.Uuid
  scope ThrottleScope
  // E-mail normalizado (ACCOUNT) ou endereco de origem (IP).
  key   String

  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  // Null = sem bloqueio. No passado = bloqueio ja expirado.
  blockedUntil    DateTime? @map("blocked_until")

  // Quantas vezes este alvo ja foi bloqueado. Define a duracao do proximo
  // bloqueio (backoff exponencial) e SOBREVIVE ao fim do bloqueio - senao
  // o atacante levaria sempre a punicao minima, bastando esperar.
  blockLevel Int @default(0) @map("block_level")

  // Quando o nivel exige liberacao manual (ultimo degrau, conforme
  // configuracao). Nesse caso blocked_until fica nulo: nao ha prazo.
  requiresManualUnlock Boolean @default(false) @map("requires_manual_unlock")

  // Ultima falha registrada. Base para zerar o nivel apos um periodo longo
  // sem nenhuma tentativa - nao da para usar updated_at, que mudaria em
  // qualquer escrita futura nesta linha.
  lastFailureAt DateTime @default(now()) @map("last_failure_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([scope, key])
  // O expurgo varre por aqui (ver utils/auditRetention.ts).
  @@index([updatedAt])
  @@map("login_throttle")
}

// ============================================================
// Log de auditoria - registra as acoes dos usuarios no sistema
// (login, logout, criacao/edicao/exclusao de usuarios, contratos
// e iframes). Visivel apenas para ADMIN na tela de Logs.
// ============================================================
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  // Autor da acao. Fica null quando a acao nao tem usuario logado
  // (ex.: tentativa de login com e-mail inexistente) ou apos o usuario ser excluido.
  userId      String?  @map("user_id") @db.Uuid
  // Snapshot do autor no momento da acao: preserva o historico mesmo
  // se o usuario for renomeado ou excluido depois.
  userName    String?  @map("user_name")
  userEmail   String?  @map("user_email")
  action      String // ex.: LOGIN, USER_CREATE, CONTRACT_DELETE
  entity      String? // ex.: User, Contract, Iframe
  entityId    String?  @map("entity_id")
  description String?  @db.Text
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserContract {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([userId, contractId])
  @@index([userId])
  @@index([contractId])
  @@map("user_contracts")
}
