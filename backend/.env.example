# ============================================================
# Banco de dados (PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/powerbi_manager?schema=public"

# ============================================================
# Autenticacao
# ============================================================
# Troque por um segredo longo e aleatorio em producao.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"
# Tempo de expiracao do token (formato aceito pelo jsonwebtoken)
JWT_EXPIRES_IN="8h"
# Custo do hash bcrypt
BCRYPT_SALT_ROUNDS=10

# ============================================================
# Servidor
# ============================================================
PORT=3333
NODE_ENV=development

# Origens permitidas no CORS (separadas por virgula, ou * para liberar todas)
CORS_ORIGIN="http://localhost:5173"

# ============================================================
# Auditoria
# ============================================================
# Por quantos dias os registros de audit_logs sao mantidos. Um job diario
# apaga o que passar disso. Os logs guardam IP e user-agent (dado pessoal),
# entao guardar para sempre e exposicao sem finalidade.
# Use 0 para desligar o expurgo (ex.: exigencia contratual de guarda).
AUDIT_LOG_RETENTION_DAYS=365

# ============================================================
# Seed (usuario administrador inicial)
# ============================================================
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@sistema.com"
SEED_ADMIN_PASSWORD="admin123"
