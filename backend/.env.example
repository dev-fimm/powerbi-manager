# ============================================================
# Banco de dados (PostgreSQL)
# ============================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/powerbi_manager?schema=public"

# ============================================================
# Autenticacao
# ============================================================
# Troque por um segredo longo e aleatorio em producao.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"
# Tempo de expiracao do token (formato aceito pelo jsonwebtoken)
JWT_EXPIRES_IN="8h"
# Custo do hash bcrypt
BCRYPT_SALT_ROUNDS=10

# ============================================================
# Servidor
# ============================================================
PORT=3333
NODE_ENV=development

# Origens permitidas no CORS (separadas por virgula, ou * para liberar todas)
CORS_ORIGIN="http://localhost:5173"

# ============================================================
# Protecao contra forca bruta no login
# ============================================================
# Erros de senha tolerados, por conta, dentro da janela abaixo.
LOGIN_THROTTLE_MAX_ATTEMPTS=3
# Tamanho da janela de contagem, em segundos.
LOGIN_THROTTLE_WINDOW_SECONDS=60

# Limite por ENDERECO IP. Separado e maior que o da conta de proposito: num
# escritorio varias pessoas saem pelo mesmo IP, e aplicar o limite da conta
# ao IP derrubaria o login de todo mundo por causa de poucos erros alheios.
# Padrao: 5x o limite da conta.
LOGIN_THROTTLE_IP_MAX_ATTEMPTS=15

# Duracao de cada bloqueio, em segundos, separada por virgula (backoff
# exponencial). O ultimo degrau vale para todos os bloqueios seguintes.
# Padrao: 1min, 5min, 15min, 1h, 24h.
LOGIN_THROTTLE_BLOCK_STEPS=60,300,900,3600,86400

# Tempo sem NENHUMA tentativa falha para o nivel de bloqueio voltar a zero.
# O nivel nao zera quando o bloqueio expira - senao bastaria esperar para
# levar sempre a punicao minima.
LOGIN_THROTTLE_LEVEL_RESET_SECONDS=86400

# true = o ultimo degrau nao tem prazo e exige liberacao manual (redefinir a
# senha da conta pelo administrador libera). false = usa a duracao do ultimo
# degrau (24h, no padrao acima).
LOGIN_THROTTLE_MANUAL_UNLOCK=false

# ============================================================
# Auditoria
# ============================================================
# Por quantos dias os registros de audit_logs sao mantidos. Um job diario
# apaga o que passar disso. Os logs guardam IP e user-agent (dado pessoal),
# entao guardar para sempre e exposicao sem finalidade.
# Use 0 para desligar o expurgo (ex.: exigencia contratual de guarda).
AUDIT_LOG_RETENTION_DAYS=365

# ============================================================
# Seed (usuario administrador inicial)
# ============================================================
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@sistema.com"
SEED_ADMIN_PASSWORD="admin123"
